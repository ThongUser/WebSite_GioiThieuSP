@model IEnumerable<WebSite_GioiThieuSP.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Products</h1>
        <p><a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> Add product</a></p>

        <div class="panel panel-default">
            <div class="panel-heading">Product list</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@Url.Content(product.ImageUrl.StartsWith("~/") ? product.ImageUrl : "~/" + product.ImageUrl.TrimStart('/'))" alt="@product.Name" style="width:60px;height:60px;object-fit:cover;" />
                                    }
                                </td>
                                <td>@product.Name</td>
                                <td>@product.Category?.Name</td>
                                <td>@product.Price.ToString("N2")</td>
                                <td>@(product.IsActive ? "Active" : "Inactive")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-xs btn-primary">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this product?');">
                                        <button type="submit" class="btn btn-xs btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
