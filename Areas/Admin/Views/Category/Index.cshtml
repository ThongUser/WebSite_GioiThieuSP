@model IEnumerable<WebSite_GioiThieuSP.Models.Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Manage Categories</h1>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel panel-default">
    <div class="panel-heading">
        <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus fa-fw"></i> Add Category</a>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Id</td>
                            <td>@category.Name</td>
                            <td>@category.Description</td>
                            <td>@(category.IsActive ? "Visible" : "Hidden")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-primary btn-xs"><i class="fa fa-pencil"></i> Edit</a>
                                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i> Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>