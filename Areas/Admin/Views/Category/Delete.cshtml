@model WebSite_GioiThieuSP.Models.Category
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Delete Category</h1>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="panel panel-danger">
            <div class="panel-heading">Confirm Deletion</div>
            <div class="panel-body">
                <p class="alert alert-warning">Are you sure you want to delete this category?</p>
                <dl class="dl-horizontal">
                    <dt>ID</dt>
                    <dd>@Model.Id</dd>
                    <dt>Category Name</dt>
                    <dd>@Model.Name</dd>
                    <dt>Status</dt>
                    <dd>@(Model.IsActive ? "Visible" : "Hidden")</dd>
                </dl>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button>
                    <a asp-action="Index" class="btn btn-default">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>