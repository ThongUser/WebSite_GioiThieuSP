@model WebSite_GioiThieuSP.Models.Order
@{
    ViewData["Title"] = "Order Details";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Order #@Model.OrderId</h1>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">Customer Information</div>
            <div class="panel-body">
                <p><strong>Customer Name:</strong> @Model.CustomerName</p>
                <p><strong>Phone Number:</strong> @Model.PhoneNumber</p>
                <p><strong>Address:</strong> @Model.Address</p>
                <p><strong>Note:</strong> @(string.IsNullOrEmpty(Model.Note) ? "N/A" : Model.Note)</p>
                <p><strong>Order Date:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Status:</strong> <span class="label label-primary">@Model.Status</span></p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">Order Summary</div>
            <div class="panel-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails ?? new List<OrderDetail>())
                        {
                            <tr>
                                <td>@detail.Product?.ProductName</td>
                                <td>@detail.Quantity</td>
                                <td>$@detail.UnitPrice.ToString("N2")</td>
                                <td>$@(detail.Quantity * detail.UnitPrice).ToString("N2")</td>
                            </tr>
                        }
                        <tr class="info">
                            <td colspan="3"><strong>Grand Total</strong></td>
                            <td><strong>$@Model.OrderDetails?.Sum(d => d.Quantity * d.UnitPrice).ToString("N2")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <a asp-action="Index" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.OrderId" class="btn btn-primary"><i class="fa fa-edit"></i> Edit Order</a>
    </div>
</div>